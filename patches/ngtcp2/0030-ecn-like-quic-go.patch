+  size_t i;
+
+  if (pkt_num > largest_ack) {
+    return 0;
+  }
+  if (pkt_num >= min_ack) {
+    return 1;
+  }
+
+  for (i = 0; i < fr->rangecnt; ++i) {
+    largest_ack = min_ack - (int64_t)fr->ranges[i].gap - 2;
+    min_ack = largest_ack - (int64_t)fr->ranges[i].len;
+    if (pkt_num > largest_ack) {
+      return 0;
+    }
+    if (pkt_num >= min_ack) {
+      return 1;
+    }
+  }
+
+  return 0;
+}
