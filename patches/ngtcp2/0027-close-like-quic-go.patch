+  /* And an Initial CONNECTION_CLOSE the same way: it carries no ACK, so
+     its padding comes first, then the frame (appendPacketPayload, as
+     packConnectionClose reaches it through appendLongHeaderPacket,
+     vendor/quic-go/packet_packer.go:295-300). */
+  if (type == NGTCP2_PKT_INITIAL && lfr.padding.len &&
+      fr->hd.type == NGTCP2_FRAME_CONNECTION_CLOSE) {
+    uint8_t *pad = ppe.buf.begin + ppe.hdlen;
+    size_t rest = ngtcp2_buf_len(&ppe.buf) - ppe.hdlen - lfr.padding.len;
+
+    memmove(pad + lfr.padding.len, pad, rest);
+    memset(pad, 0, lfr.padding.len);
+  }
