+       client has sent since it last changed its Destination
+       Connection ID, and how many it sends before the next change.
+       See conn_qgo_update_dcid. */
+    uint32_t pkts_since_change;
+    uint32_t pkts_per_change;
   } dcid;
 
   struct {
