diff -Naur a/lib/ngtcp2_rtb.c b/lib/ngtcp2_rtb.c
--- a/lib/ngtcp2_rtb.c
+++ b/lib/ngtcp2_rtb.c
@@ -1905,3 +1905,47 @@
 
   return (ngtcp2_ssize)(atmost - num_pkts);
 }
+
+int ngtcp2_rtb_queue_probe(ngtcp2_rtb *rtb, ngtcp2_conn *conn,
+                           ngtcp2_pktns *pktns, ngtcp2_conn_stat *cstat) {
+  ngtcp2_ksl_it it;
+  ngtcp2_rtb_entry *ent;
+  ngtcp2_ssize reclaimed;
+  int rv;
+
+  /* Oldest first: FirstOutstanding walks the history from its start
+     (vendor/quic-go/internal/ackhandler/sent_packet_history.go:102-113),
+     and Outstanding is ack-eliciting, not a path MTU probe
+     (vendor/quic-go/internal/ackhandler/packet.go:30-32). */
+  it = ngtcp2_ksl_end(&rtb->ents);
+  while (!ngtcp2_ksl_it_begin(&it)) {
+    ngtcp2_ksl_it_prev(&it);
+    ent = ngtcp2_ksl_it_get(&it);
+
+    if ((ent->flags & (NGTCP2_RTB_ENTRY_FLAG_LOST_RETRANSMITTED |
+                       NGTCP2_RTB_ENTRY_FLAG_SKIP |
+                       NGTCP2_RTB_ENTRY_FLAG_PMTUD_PROBE)) ||
+        !(ent->flags & NGTCP2_RTB_ENTRY_FLAG_ACK_ELICITING)) {
+      continue;
+    }
+
+    if ((ent->flags & NGTCP2_RTB_ENTRY_FLAG_RETRANSMITTABLE) &&
+        !(ent->flags & NGTCP2_RTB_ENTRY_FLAG_PTO_RECLAIMED)) {
+      reclaimed =
+        rtb_reclaim_frame(rtb, NGTCP2_RECLAIM_FLAG_ON_LOSS, conn, pktns, ent);
+      if (reclaimed < 0) {
+        return (int)reclaimed;
+      }
+    }
+
+    rtb_on_remove(rtb, ent, cstat);
+    rv = ngtcp2_ksl_remove_hint(&rtb->ents, &it, &it, &ent->hd.pkt_num);
+    assert(0 == rv);
+    ngtcp2_rtb_entry_objalloc_del(ent, rtb->rtb_entry_objalloc,
+                                  rtb->frc_objalloc, rtb->mem);
+
+    return 1;
+  }
+
+  return 0;
+}
diff -Naur a/lib/ngtcp2_rtb.h b/lib/ngtcp2_rtb.h
--- a/lib/ngtcp2_rtb.h
+++ b/lib/ngtcp2_rtb.h
@@ -318,4 +318,21 @@
 ngtcp2_ssize ngtcp2_rtb_reclaim_on_pto(ngtcp2_rtb *rtb, ngtcp2_conn *conn,
                                        ngtcp2_pktns *pktns, size_t num_pkts);
 
+/*
+ * ngtcp2_rtb_queue_probe is quic-go's QueueProbePacket
+ * (vendor/quic-go/internal/ackhandler/sent_packet_handler.go:1120-1133),
+ * which a client runs before each probe it packs: the oldest packet still
+ * outstanding — ack-eliciting, not a path MTU probe, not declared lost —
+ * is taken out of flight and out of ngtcp2_rtb, and its frames are
+ * queued to be sent again.  Nobody is told of a loss: not the
+ * controller, not the ECN tracker, not the count of lost packets.  A
+ * later ACK of it acknowledges nothing, as the packet has left quic-go's
+ * history.
+ *
+ * It returns 1 if a packet was taken, 0 if none was outstanding, or
+ * NGTCP2_ERR_NOMEM.
+ */
+int ngtcp2_rtb_queue_probe(ngtcp2_rtb *rtb, ngtcp2_conn *conn,
+                           ngtcp2_pktns *pktns, ngtcp2_conn_stat *cstat);
+
 #endif /* !defined(NGTCP2_RTB_H) */
