 /*
+ * A client's transport errors as quic-go closes on them.
+ *
+ * quic-go puts three things in the CONNECTION_CLOSE a transport error
+ * ends the connection with: the error code, the type of the frame it
+ * happened on, and its own message as the reason
+ * (vendor/quic-go/packet_packer.go:202-208).  ngtcp2 returns only a
+ * liberr, from which ngtcp2_ccerr_set_liberr infers a code and nothing
+ * else.  So every check a server's packet can fail records, where it
+ * fails, what quic-go says at the same point, and the client closes
+ * with that (ngtcp2_conn_get_qgo_ccerr).
+ */
+
+/*
+ * ngtcp2_conn_qgo_close records |error_code|, |frame_type| and the reason
+ * formatted from |fmt| as the close of a client, unless one is already
+ * recorded in this call: quic-go stops at the first error it meets.
+ * It returns |liberr|, so that a check reads
+ * `return ngtcp2_conn_qgo_close(conn, NGTCP2_ERR_..., ...);`.
+ */
+int ngtcp2_conn_qgo_close(ngtcp2_conn *conn, int liberr, uint64_t error_code,
+                          uint64_t frame_type, const char *fmt, ...) {
+  va_list ap;
+  int n;
+
+  if (conn->server || conn->qgo_close.set) {
+    return liberr;
+  }
+
+  conn->qgo_close.set = 1;
+  conn->qgo_close.error_code = error_code;
+  conn->qgo_close.frame_type = frame_type;
+
+  va_start(ap, fmt);
+  n = vsnprintf((char *)conn->qgo_close.reason, sizeof(conn->qgo_close.reason),
+                fmt, ap);
+  va_end(ap);
+
+  if (n < 0) {
+    n = 0;
+  } else if ((size_t)n >= sizeof(conn->qgo_close.reason)) {
+    n = (int)sizeof(conn->qgo_close.reason) - 1;
+  }
+  conn->qgo_close.reasonlen = (size_t)n;
+
+  return liberr;
+}
+
+int ngtcp2_conn_get_qgo_ccerr(const ngtcp2_conn *conn, ngtcp2_ccerr *ccerr) {
+  if (!conn->qgo_close.set) {
+    return 0;
+  }
+
+  ngtcp2_ccerr_default(ccerr);
+  ccerr->type = NGTCP2_CCERR_TYPE_TRANSPORT;
+  ccerr->error_code = conn->qgo_close.error_code;
+  ccerr->frame_type = conn->qgo_close.frame_type;
+  ccerr->reason = (uint8_t *)conn->qgo_close.reason;
+  ccerr->reasonlen = conn->qgo_close.reasonlen;
+
+  return 1;
+}
