+  case NGTCP2_ENCRYPTION_LEVEL_HANDSHAKE:
+    return "Handshake";
+  case NGTCP2_ENCRYPTION_LEVEL_0RTT:
+    return "0-RTT";
+  case NGTCP2_ENCRYPTION_LEVEL_1RTT:
