+int ngtcp2_conn_qgo_check_control_frames(ngtcp2_conn *conn) {
+  ngtcp2_frame_chain *frc;
+  size_t n = 0;
+
+  /* The 1-RTT queue, which is the one quic-go's framer holds.  quic-go
+     drops the frame that finds maxControlFrames already queued and raises
+     the flag; ngtcp2 keeps it, so the flag is one more than the limit. */
+  for (frc = conn->pktns.tx.frq; frc; frc = frc->next) {
+    if (++n > NGTCP2_QGO_MAX_CONTROL_FRAMES) {
+      return ngtcp2_conn_qgo_close(conn, NGTCP2_ERR_INTERNAL,
+                                   QGO_INTERNAL_ERROR, 0, "");
+    }
+  }
+
+  return 0;
