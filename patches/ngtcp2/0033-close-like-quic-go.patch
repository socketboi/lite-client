+  for (; off < n;) {
+    len = qgo_varint(&type, p + off, n - off);
+    if (len == 0) {
+      return ngtcp2_conn_qgo_close(conn, NGTCP2_ERR_FRAME_ENCODING,
+                            QGO_FRAME_ENCODING_ERROR, 0, "unexpected EOF");
