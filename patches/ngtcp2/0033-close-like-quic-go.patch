+static size_t qgo_varint(uint64_t *dest, const uint8_t *p, size_t n) {
+  size_t len;
+
+  if (n == 0) {
+    return 0;
+  }
+
+  len = ngtcp2_get_uvarintlen(p);
+  if (n < len) {
+    return 0;
+  }
+
+  ngtcp2_get_uvarint(dest, p);
+
+  return len;
