+  switch (id) {
+  case 0x1:           /* max_idle_timeout */
+  case 0x3:           /* max_udp_payload_size */
+  case 0x4:           /* initial_max_data */
+  case 0x5:           /* initial_max_stream_data_bidi_local */
+  case 0x6:           /* initial_max_stream_data_bidi_remote */
+  case 0x7:           /* initial_max_stream_data_uni */
+  case 0x8:           /* initial_max_streams_bidi */
+  case 0x9:           /* initial_max_streams_uni */
+  case 0xa:           /* ack_delay_exponent */
+  case 0xb:           /* max_ack_delay */
+  case 0xe:           /* active_connection_id_limit */
+  case 0x20:          /* max_datagram_frame_size */
+  case 0xff04de1bULL: /* min_ack_delay */
+    return 1;
+  default:
+    return 0;
+  }
+}
+
+int ngtcp2_qgo_transport_params_check(const uint8_t *data, size_t datalen,
+                                      char *msg, size_t msgcap) {
+  const uint8_t *b = data;
+  size_t n = datalen, l, i, j, nids = 0;
+  uint64_t id, len, val, t;
+  uint64_t ids[256];
+  const char *err;
+  int odcid = 0, iscid = 0, min_ack_delay_set = 0;
+  /* Durations in nanoseconds: DefaultMaxAckDelay until one is read
+     (vendor/quic-go/internal/protocol/protocol.go:143). */
+  uint64_t max_ack_delay = 25000000ULL, min_ack_delay = 0;
+  char d1[32], d2[32];
+
+  for (; n > 0;) {
+    l = qgo_varint(&id, b, n, &err);
+    if (l == 0) {
+      snprintf(msg, msgcap, "%s", err);
+      return -1;
+    }
+    b += l;
+    n -= l;
+
+    l = qgo_varint(&len, b, n, &err);
+    if (l == 0) {
+      snprintf(msg, msgcap, "%s", err);
+      return -1;
+    }
+    b += l;
+    n -= l;
+
+    if (n < len) {
+      snprintf(msg, msgcap,
+               "remaining length (%zu) smaller than parameter length (%llu)", n,
+               (unsigned long long)len);
+      return -1;
+    }
+
+    if (nids < ngtcp2_arraylen(ids)) {
+      ids[nids++] = id;
+    }
+
+    if (qgo_numeric_param(id)) {
+      /* The number is read from the rest of the buffer, not from the
+         parameter's own bytes, and its length is compared afterwards
+         (readNumericTransportParameter, :298-305). */
+      l = qgo_varint(&val, b, n, &err);
+      if (l == 0) {
+        snprintf(msg, msgcap, "error while reading transport parameter %llu: %s",
+                 (unsigned long long)id, err);
+        return -1;
+      }
+      if (l != len) {
+        snprintf(msg, msgcap,
+                 "inconsistent transport parameter length for transport "
+                 "parameter %#llx",
+                 (unsigned long long)id);
+        return -1;
+      }
+
+      switch (id) {
+      case 0x8:
+        if (val > (1ULL << 60)) {
+          snprintf(msg, msgcap,
+                   "initial_max_streams_bidi too large: %llu (maximum %llu)",
+                   (unsigned long long)val, 1ULL << 60);
+          return -1;
+        }
+        break;
+      case 0x9:
+        if (val > (1ULL << 60)) {
+          snprintf(msg, msgcap,
+                   "initial_max_streams_uni too large: %llu (maximum %llu)",
+                   (unsigned long long)val, 1ULL << 60);
+          return -1;
+        }
+        break;
+      case 0x3:
+        if (val < 1200) {
+          snprintf(msg, msgcap,
+                   "invalid value for max_udp_payload_size: %llu (minimum "
+                   "1200)",
+                   (unsigned long long)val);
+          return -1;
+        }
+        break;
+      case 0xa:
+        if (val > 20) {
+          snprintf(msg, msgcap,
+                   "invalid value for ack_delay_exponent: %llu (maximum 20)",
+                   (unsigned long long)val);
+          return -1;
+        }
+        break;
+      case 0xb:
+        if (val > 16383) {
+          snprintf(msg, msgcap,
+                   "invalid value for max_ack_delay: %llums (maximum 16383ms)",
+                   (unsigned long long)val);
+          return -1;
+        }
+        max_ack_delay = val * 1000000ULL;
+        break;
+      case 0xe:
+        if (val < 2) {
+          snprintf(msg, msgcap,
+                   "invalid value for active_connection_id_limit: %llu "
+                   "(minimum 2)",
+                   (unsigned long long)val);
+          return -1;
+        }
+        break;
+      case 0xff04de1bULL:
+        /* time.Duration(val) * time.Microsecond, wrapping as Go's int64
+           does, and a negative result taken as the largest. */
+        t = val * 1000ULL;
+        min_ack_delay = (t >> 63) ? (uint64_t)INT64_MAX : t;
+        min_ack_delay_set = 1;
+        break;
+      }
+
+      b += len;
+      n -= len;
+      continue;
+    }
+
+    switch (id) {
+    case 0xd: /* preferred_address, read from the rest of the buffer */
+      if (n < 4 + 2 + 16 + 2 + 1) {
+        snprintf(msg, msgcap, "EOF");
+        return -1;
+      }
+      l = b[4 + 2 + 16 + 2];
+      if (l == 0 || l > 20) {
+        snprintf(msg, msgcap, "invalid connection ID length: %zu", l);
+        return -1;
+      }
+      if (n - (4 + 2 + 16 + 2 + 1) < l + 16) {
+        snprintf(msg, msgcap, "EOF");
+        return -1;
+      }
+      if (4 + 2 + 16 + 2 + 1 + l + 16 != len) {
+        snprintf(msg, msgcap,
+                 "expected preferred_address to be %llu long, read %zu bytes",
+                 (unsigned long long)len, 4 + 2 + 16 + 2 + 1 + l + 16);
+        return -1;
+      }
+      break;
+    case 0xc: /* disable_active_migration */
+      if (len != 0) {
+        snprintf(msg, msgcap,
+                 "wrong length for disable_active_migration: %llu (expected "
+                 "empty)",
+                 (unsigned long long)len);
+        return -1;
+      }
+      break;
+    case 0x2: /* stateless_reset_token */
+      if (len != 16) {
+        snprintf(msg, msgcap,
+                 "wrong length for stateless_reset_token: %llu (expected 16)",
+                 (unsigned long long)len);
+        return -1;
+      }
+      break;
+    case 0x0:  /* original_destination_connection_id */
+    case 0xf:  /* initial_source_connection_id */
+    case 0x10: /* retry_source_connection_id */
+      if (len > 20) {
+        snprintf(msg, msgcap, "invalid Connection ID length");
+        return -1;
+      }
+      if (id == 0x0) {
+        odcid = 1;
+      } else if (id == 0xf) {
+        iscid = 1;
+      }
+      break;
+    case 0x1d:                /* reset_stream_at */
+    case 0x17f7586d2cb571ULL: /* its draft number */
+      if (len != 0) {
+        snprintf(msg, msgcap,
+                 "wrong length for reset_stream_at: %llu (expected empty)",
+                 (unsigned long long)len);
+        return -1;
+      }
+      break;
+    }
+
+    b += len;
+    n -= len;
+  }
+
+  if (min_ack_delay_set && min_ack_delay > max_ack_delay) {
+    qgo_duration(d1, sizeof(d1), min_ack_delay);
+    qgo_duration(d2, sizeof(d2), max_ack_delay);
+    snprintf(msg, msgcap, "min_ack_delay (%s) is greater than max_ack_delay (%s)",
+             d1, d2);
+    return -1;
+  }
+  if (!odcid) {
+    snprintf(msg, msgcap, "missing original_destination_connection_id");
+    return -1;
+  }
+  if (!iscid) {
+    snprintf(msg, msgcap, "missing initial_source_connection_id");
+    return -1;
+  }
+
+  /* Every parameter at most once, the lowest repeated one named: the
+     IDs sorted, then compared with their neighbours (:248-254). */
+  for (i = 0; i < nids; ++i) {
+    for (j = i + 1; j < nids; ++j) {
+      if (ids[j] < ids[i]) {
+        t = ids[i];
+        ids[i] = ids[j];
+        ids[j] = t;
+      }
+    }
+    if (i > 0 && ids[i] == ids[i - 1]) {
+      snprintf(msg, msgcap, "received duplicate transport parameter %#llx",
+               (unsigned long long)ids[i]);
+      return -1;
+    }
+  }
+
+  return 0;
+}
diff -Naur a/lib/ngtcp2_transport_params.h b/lib/ngtcp2_transport_params.h
--- a/lib/ngtcp2_transport_params.h
+++ b/lib/ngtcp2_transport_params.h
@@ -115,4 +115,19 @@
                                             ngtcp2_transport_params *dest,
                                             const ngtcp2_transport_params *src);
 
+
+/*
+ * ngtcp2_qgo_transport_params_check reads the |datalen| bytes of the
+ * transport parameters a server sent as quic-go's
+ * TransportParameters.Unmarshal does
+ * (vendor/quic-go/internal/wire/transport_parameters.go:103-296): the
+ * same checks, in the same order, and on the first one that fails the
+ * same message, written to |msg| (|msgcap| bytes, NUL-terminated).  It
+ * returns 0 when quic-go takes them and -1 when it does not.  What
+ * quic-go does not know it steps over: version_information and
+ * grease_quic_bit among them, which ngtcp2's own decoder checks.
+ */
+int ngtcp2_qgo_transport_params_check(const uint8_t *data, size_t datalen,
+                                      char *msg, size_t msgcap);
+
 #endif /* !defined(NGTCP2_TRANSPORT_PARAMS_H) */
