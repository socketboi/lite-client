+/*
+ * THE CONGESTION CONTROL HYSTERIA USES, WHICH IS NOT THE ONE ngtcp2 SHIPS.
+ *
+ * A hysteria client that is given no bandwidth in its configuration does not fall back to the
+ * library's congestion control: it replaces it, with a port of Chromium's BBRv1 that the project
+ * carries itself —
+ * `congestion.UseConfigured(conn, ...)` -> `UseBBR` -> `bbr.NewBbrSender(...)`
+ * (vendor/hysteria/core/client/client.go:153, core/internal/congestion/utils.go:37-43). So the
+ * sending rhythm of every reference client on the wire is this algorithm's, and ngtcp2's own BBR —
+ * a different algorithm, BBRv2, with a different state machine and different constants — is what
+ * this client sent with until now.
+ *
+ * This is that port: the same states, the same gains, the same bandwidth sampler, the same ack
+ * aggregation tracker, from
+ * vendor/hysteria/core/internal/congestion/bbr/{bbr_sender,bandwidth_sampler,windowed_filter,
+ * packet_number_indexed_queue,ringbuffer,bandwidth}.go and core/internal/congestion/common/pacer.go.
+ * Line references in the implementation are to those files.
+ *
+ * WHAT IS NOT THE SAME, and there is one thing: HOW THE PACE IS APPLIED. The reference hands its
+ * pacing rate to a token bucket that quic-go's send loop consults per packet; ngtcp2 paces by
+ * writing a batch and then waiting for the batch's worth of time
+ * (ngtcp2_conn_update_pkt_tx_time). The rate is the same number and the burst ceiling is the same
+ * number — `send_quantum` is given the reference pacer's maxBurstSize — so what differs is which
+ * of the two accounts for a burst, not how fast or how large one is.
+ */
+
+typedef struct ngtcp2_hybbr ngtcp2_hybbr;
+typedef struct ngtcp2_conn ngtcp2_conn;
+
+/* One slot of a windowed filter: Kathleen Nichols' algorithm keeps three. */
+typedef struct ngtcp2_hybbr_bw_entry {
+  uint64_t sample;
+  uint64_t time;
+} ngtcp2_hybbr_bw_entry;
+
+/* The excess bytes acknowledged in one ack-aggregation epoch, which is what the max-ack-height
+ * filter keeps (core/internal/congestion/bbr/bandwidth_sampler.go:59-68). */
+typedef struct ngtcp2_hybbr_extra_acked {
+  uint64_t extra_acked;
+  uint64_t bytes_acked;
+  ngtcp2_duration time_delta;
+  uint64_t round;
+} ngtcp2_hybbr_extra_acked;
+
+typedef struct ngtcp2_hybbr_extra_acked_entry {
+  ngtcp2_hybbr_extra_acked sample;
+  uint64_t time;
+} ngtcp2_hybbr_extra_acked_entry;
+
+/* A point on the ack line: when, and how many bytes had been acknowledged by then
+ * (core/internal/congestion/bbr/bandwidth_sampler.go:243-247). */
+typedef struct ngtcp2_hybbr_ack_point {
+  ngtcp2_tstamp ack_time;
+  uint64_t total_bytes_acked;
+} ngtcp2_hybbr_ack_point;
+
+/* What was true of the connection when a packet was sent, returned to the controller when that
+ * packet is acknowledged or lost (core/internal/congestion/bbr/bandwidth_sampler.go:19-40). */
+typedef struct ngtcp2_hybbr_send_state {
+  int is_valid;
+  int is_app_limited;
+  uint64_t total_bytes_sent;
+  uint64_t total_bytes_acked;
+  uint64_t total_bytes_lost;
+  uint64_t bytes_in_flight;
+} ngtcp2_hybbr_send_state;
+
+/* The whole of what the sampler records about one sent packet (core/internal/congestion/bbr/bandwidth_sampler.go:282-303). */
+typedef struct ngtcp2_hybbr_sent_packet {
+  ngtcp2_tstamp sent_time;
+  uint64_t size;
+  uint64_t total_bytes_sent_at_last_acked_packet;
+  ngtcp2_tstamp last_acked_packet_sent_time;
+  ngtcp2_tstamp last_acked_packet_ack_time;
+  ngtcp2_hybbr_send_state send_time_state;
+} ngtcp2_hybbr_sent_packet;
+
+/* A ring buffer, grown by doubling, holding elements of one size. The reference has one per type
+ * through generics (ringbuffer.go); one with an element size does for both here. */
+typedef struct ngtcp2_hybbr_ring {
+  uint8_t *buf;
+  size_t elem_size;
+  size_t cap;
+  size_t head;
+  size_t tail;
+  int full;
+  const ngtcp2_mem *mem;
+} ngtcp2_hybbr_ring;
+
+/* The packet-number-indexed queue the sampler keeps its sent packets in
+ * (packet_number_indexed_queue.go). Entries are a presence flag and the record. */
+typedef struct ngtcp2_hybbr_pnq {
+  ngtcp2_hybbr_ring entries;
+  int64_t number_of_present_entries;
+  int64_t first_packet;
+} ngtcp2_hybbr_pnq;
+
+/* The bandwidth sampler (core/internal/congestion/bbr/bandwidth_sampler.go:441-497). */
+typedef struct ngtcp2_hybbr_sampler {
+  uint64_t total_bytes_sent;
+  uint64_t total_bytes_acked;
+  uint64_t total_bytes_lost;
+  uint64_t total_bytes_neutered;
+  uint64_t total_bytes_sent_at_last_acked_packet;
+  ngtcp2_tstamp last_acked_packet_sent_time;
+  ngtcp2_tstamp last_acked_packet_ack_time;
+  int64_t last_sent_packet;
+  int64_t last_acked_packet;
+  int is_app_limited;
+  int64_t end_of_app_limited_phase;
+  ngtcp2_hybbr_pnq connection_state_map;
+
+  /* recentAckPoints: the two most recent ack points at distinct times. */
+  ngtcp2_hybbr_ack_point ack_points[2];
+  ngtcp2_hybbr_ring a0_candidates;
+
+  /* maxAckHeightTracker (core/internal/congestion/bbr/bandwidth_sampler.go:100-117). */
+  ngtcp2_hybbr_extra_acked_entry max_ack_height_filter[3];
+  uint64_t max_ack_height_window;
+  ngtcp2_tstamp aggregation_epoch_start_time;
+  uint64_t aggregation_epoch_bytes;
+  int64_t last_sent_packet_number_before_epoch;
+  uint64_t num_ack_aggregation_epochs;
+  double ack_aggregation_bandwidth_threshold;
+  int start_new_aggregation_epoch_after_full_round;
+  int reduce_extra_acked_on_bandwidth_increase;
+
+  uint64_t total_bytes_acked_after_last_ack_event;
+  int overestimate_avoidance;
+  int limit_max_ack_height_tracker_by_send_rate;
+} ngtcp2_hybbr_sampler;
+
+/* One acknowledged or lost packet, as the event batch carries it. */
+typedef struct ngtcp2_hybbr_pkt {
+  int64_t pkt_num;
+  uint64_t bytes;
+} ngtcp2_hybbr_pkt;
+
+/* The token-bucket pacer the reference gives BBR (common/pacer.go). */
+typedef struct ngtcp2_hybbr_pacer {
+  uint64_t budget_at_last_sent;
+  uint64_t max_datagram_size;
+  ngtcp2_tstamp last_sent_time;
+} ngtcp2_hybbr_pacer;
+
+struct ngtcp2_hybbr {
+  ngtcp2_cc cc;
+  ngtcp2_log *log;
+  ngtcp2_conn_stat *cstat;
+  ngtcp2_pcg32 *pcg;
+  const ngtcp2_mem *mem;
+
+  ngtcp2_hybbr_sampler sampler;
+  ngtcp2_hybbr_pacer pacer;
+
+  int mode;
+  int recovery_state;
+
+  uint64_t round_trip_count;
+  int64_t last_sent_packet;
+  int64_t current_round_trip_end;
+
+  uint64_t num_loss_events_in_round;
+  uint64_t bytes_lost_in_round;
+
+  /* maxBandwidth, a windowed max filter over round trips. */
+  ngtcp2_hybbr_bw_entry max_bandwidth[3];
+  uint64_t max_bandwidth_window;
+
+  ngtcp2_duration min_rtt;
+  ngtcp2_tstamp min_rtt_timestamp;
+
+  uint64_t congestion_window;
+  uint64_t initial_congestion_window;
+  uint64_t max_congestion_window;
+  uint64_t min_congestion_window;
+
+  double high_gain;
+  double high_cwnd_gain;
+  double drain_gain;
+
+  uint64_t pacing_rate; /* bits per second */
+  double pacing_gain;
+  double congestion_window_gain;
+  double congestion_window_gain_constant;
+  int64_t num_startup_rtts;
+
+  int cycle_current_offset;
+  ngtcp2_tstamp last_cycle_start;
+
+  int is_at_full_bandwidth;
+  int64_t rounds_without_bandwidth_gain;
+  uint64_t bandwidth_at_last_round;
+
+  int exiting_quiescence;
+
+  ngtcp2_tstamp exit_probe_rtt_at;
+  int probe_rtt_round_passed;
+
+  int last_sample_is_app_limited;
+  int has_no_app_limited_sample;
+
+  int64_t end_recovery_at;
+  uint64_t recovery_window;
+
+  int enable_ack_aggregation_during_startup;
+  int expire_ack_aggregation_in_startup;
+  int drain_to_target;
+  int detect_overshooting;
+  uint64_t bytes_lost_while_detecting_overshooting;
+  uint8_t bytes_lost_multiplier_while_detecting_overshooting;
+  uint64_t cwnd_to_calculate_min_pacing_rate;
+
+  uint64_t max_datagram_size;
+  uint64_t bytes_in_flight;
+
+  /* The batch an ACK builds: ngtcp2 reports acknowledged and lost packets one at a time, and the
+   * reference's controller is handed both lists at once (OnCongestionEventEx). They are collected
+   * here and the event is run when the ACK is finished. */
+  ngtcp2_hybbr_pkt *acked;
+  size_t acked_len;
+  size_t acked_cap;
+  ngtcp2_hybbr_pkt *lost;
+  size_t lost_len;
+  size_t lost_cap;
+  uint64_t prior_in_flight;
+  int have_prior_in_flight;
+};
+
+/*
+ * `ngtcp2_hybbr_init` initializes |hybbr|.  It cannot fail: nothing is allocated until the
+ * first packet is sent.  The connection starts at the datagram size the reference starts at —
+ * congestion.InitialPacketSize, 1280 — and follows the path's as PMTUD finds it.
+ */
+void ngtcp2_hybbr_init(ngtcp2_hybbr *hybbr, ngtcp2_log *log,
+                       ngtcp2_conn_stat *cstat, ngtcp2_tstamp initial_ts,
+                       ngtcp2_pcg32 *pcg, const ngtcp2_mem *mem);
+
+void ngtcp2_hybbr_free(ngtcp2_hybbr *hybbr);
+
+/* The pacer as the send loop consults it — the three calls quic-go's loop makes on the reference's
+ * bucket (core/internal/congestion/common/pacer.go:32-76). `budget` is how many bytes may go now, `sent` accounts for what
+ * went, and `next` is when a datagram's worth will have accumulated (0 = now). */
+int           ngtcp2_hybbr_pacer_can_send(const ngtcp2_hybbr *hybbr, ngtcp2_tstamp ts);
+uint64_t      ngtcp2_hybbr_pacer_budget(const ngtcp2_hybbr *hybbr, ngtcp2_tstamp ts);
+void          ngtcp2_hybbr_pacer_sent(ngtcp2_hybbr *hybbr, ngtcp2_tstamp ts, uint64_t size);
+ngtcp2_tstamp ngtcp2_hybbr_pacer_next(const ngtcp2_hybbr *hybbr);
+
+/* This connection's controller when it is this one, NULL otherwise. */
+ngtcp2_hybbr *ngtcp2_conn_hybbr(ngtcp2_conn *conn);
+
+/* The entry points the ngtcp2_cc vtable is filled with; declared for the tests. */
+void ngtcp2_cc_hybbr_on_pkt_sent(ngtcp2_cc *cc, ngtcp2_conn_stat *cstat,
+                                 const ngtcp2_cc_pkt *pkt);
+void ngtcp2_cc_hybbr_on_pkt_acked(ngtcp2_cc *cc, ngtcp2_conn_stat *cstat,
+                                  const ngtcp2_cc_pkt *pkt, ngtcp2_tstamp ts);
+void ngtcp2_cc_hybbr_on_pkt_lost(ngtcp2_cc *cc, ngtcp2_conn_stat *cstat,
+                                 const ngtcp2_cc_pkt *pkt, ngtcp2_tstamp ts);
+void ngtcp2_cc_hybbr_on_ack_recv(ngtcp2_cc *cc, ngtcp2_conn_stat *cstat,
+                                 const ngtcp2_cc_ack *ack, ngtcp2_tstamp ts);
+void ngtcp2_cc_hybbr_congestion_event(ngtcp2_cc *cc, ngtcp2_conn_stat *cstat,
+                                      ngtcp2_tstamp sent_ts,
+                                      const ngtcp2_cc_ack *ack,
+                                      ngtcp2_tstamp ts);
+void ngtcp2_cc_hybbr_reset(ngtcp2_cc *cc, ngtcp2_conn_stat *cstat,
+                           ngtcp2_tstamp ts);
+
+#endif /* !defined(NGTCP2_HYBBR_H) */
