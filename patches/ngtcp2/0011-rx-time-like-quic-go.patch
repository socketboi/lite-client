diff -ruN a/lib/ngtcp2_conn.c b/lib/ngtcp2_conn.c
--- a/lib/ngtcp2_conn.c
+++ b/lib/ngtcp2_conn.c
@@ -10202,6 +10202,28 @@
  * This function returns 0 if it succeeds, or the same negative error
  * codes from conn_recv_pkt except for NGTCP2_ERR_DISCARD_PKT.
  */
+/*
+ * conn_rx_pkt_ts returns the time the datagram being read arrived:
+ * what ngtcp2_conn_read_pkt_rx was told, never later than |ts| and
+ * never earlier than the last one returned, or |ts| itself when the
+ * caller did not say.  quic-go processes every packet with the time
+ * its socket read returned (receivedPacket.rcvTime); see
+ * patches/ngtcp2/0011.
+ */
+static ngtcp2_tstamp conn_rx_pkt_ts(ngtcp2_conn *conn, ngtcp2_tstamp ts) {
+  ngtcp2_tstamp pkt_ts = conn->rx_pkt_ts;
+
+  if (pkt_ts == 0 || pkt_ts > ts) {
+    pkt_ts = ts;
+  }
+  if (pkt_ts < conn->rx_pkt_ts_floor) {
+    pkt_ts = conn->rx_pkt_ts_floor;
+  }
+  conn->rx_pkt_ts_floor = pkt_ts;
+
+  return pkt_ts;
+}
