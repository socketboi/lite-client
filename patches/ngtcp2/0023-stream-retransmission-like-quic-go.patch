diff --git a/lib/ngtcp2_strm.c b/lib/ngtcp2_strm.c
index aa01434..74414ee 100644
--- a/lib/ngtcp2_strm.c
+++ b/lib/ngtcp2_strm.c
@@ -31,6 +31,98 @@
 #include "ngtcp2_pkt.h"
 #include "ngtcp2_vec.h"
 #include "ngtcp2_frame_chain.h"
+#include "ngtcp2_conv.h"
+
+static void strm_lc_rtxq_free(ngtcp2_strm *strm) {
+  ngtcp2_frame_chain *frc, *next;
+
+  for (frc = strm->tx.lc_rtxq_head; frc; frc = next) {
+    next = frc->next;
+    ngtcp2_frame_chain_objalloc_del(frc, strm->frc_objalloc, strm->mem);
+  }
+  strm->tx.lc_rtxq_head = strm->tx.lc_rtxq_tail = NULL;
+}
+
+int ngtcp2_strm_lc_rtxq_pop(ngtcp2_strm *strm, ngtcp2_frame_chain **pfrc,
+                            size_t max_bytes, int *phasmore) {
+  ngtcp2_frame_chain *frc = strm->tx.lc_rtxq_head, *nfrc;
+  ngtcp2_stream *fr, *nfr;
+  uint64_t datalen, n, left;
+  size_t hdlen, i;
+  int rv;
+
+  *pfrc = NULL;
+  *phasmore = 0;
+
+  if (frc == NULL) {
+    return 0;
+  }
+
+  fr = &frc->fr.stream;
+  datalen = ngtcp2_vec_len(fr->data, fr->datacnt);
+  hdlen = 1 + ngtcp2_put_uvarintlen((uint64_t)fr->stream_id) +
+          (fr->offset ? ngtcp2_put_uvarintlen(fr->offset) : 0);
+
+  if (max_bytes >= hdlen + ngtcp2_put_uvarintlen(datalen) + datalen) {
+    strm->tx.lc_rtxq_head = frc->next;
+    if (strm->tx.lc_rtxq_head == NULL) {
+      strm->tx.lc_rtxq_tail = NULL;
+    }
+    frc->next = NULL;
+    *pfrc = frc;
+    *phasmore = strm->tx.lc_rtxq_head != NULL;
+    return 0;
+  }
+
+  *phasmore = 1;
+
+  /* MaxDataLen with the Length field present: a byte of it reckoned,
+     one more once the data needs two
+     (vendor/quic-go/internal/wire/stream_frame.go:136-155). */
+  if (hdlen + 1 > max_bytes) {
+    return 0;
+  }
+  n = max_bytes - hdlen - 1;
+  if (ngtcp2_put_uvarintlen(n) != 1) {
+    --n;
+  }
+  if (n == 0) {
+    return 0;
+  }
+
+  rv = ngtcp2_frame_chain_stream_datacnt_objalloc_new(
+    &nfrc, fr->datacnt, strm->frc_objalloc, strm->mem);
+  if (rv != 0) {
+    return rv;
+  }
+
+  nfr = &nfrc->fr.stream;
+  nfr->type = NGTCP2_FRAME_STREAM;
+  nfr->flags = 0;
+  nfr->fin = 0;
+  nfr->stream_id = fr->stream_id;
+  nfr->offset = fr->offset;
+  nfr->datacnt = ngtcp2_vec_copy_at_most(nfr->data, fr->datacnt, fr->data,
+                                         fr->datacnt, (size_t)n);
+
+  /* The rest stays at the head, n bytes further on. */
+  for (left = n, i = 0; left && i < fr->datacnt;) {
+    if (fr->data[i].len <= left) {
+      left -= fr->data[i].len;
+      ++i;
+      continue;
+    }
+    ngtcp2_vec_drop(&fr->data[i], (size_t)left);
+    left = 0;
+  }
+  memmove(fr->data, fr->data + i, sizeof(fr->data[0]) * (fr->datacnt - i));
+  fr->datacnt -= i;
+  fr->offset += n;
+
+  *pfrc = nfrc;
+
+  return 0;
+}
 
