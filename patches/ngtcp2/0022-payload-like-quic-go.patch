+                                  size_t *acklen) {
+  ngtcp2_buf *buf = &ppe->buf;
+  size_t n = ppe->lc_nspans, nother = 0, i, j, k, len;
+  uint16_t order[NGTCP2_PPE_LC_MAX_SPANS], other[NGTCP2_PPE_LC_MAX_SPANS], t;
+  size_t payloadlen = ngtcp2_buf_len(buf) - ppe->hdlen;
+  size_t last_stream = n;
+  uint8_t *p, *q;
+  uint16_t type;
+
+  *acklen = 0;
+  if (n == 0) {
+    return 0;
+  }
+
+  if (conn->lc_payloadcap < payloadlen) {
+    p = ngtcp2_mem_realloc(conn->mem, conn->lc_payload, payloadlen);
+    if (p == NULL) {
+      return NGTCP2_ERR_NOMEM;
+    }
+    conn->lc_payload = p;
+    conn->lc_payloadcap = payloadlen;
+  }
