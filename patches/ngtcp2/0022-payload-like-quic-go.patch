+/*
+ * conn_lc_stream_max_datalen is how much of |ndatalen| bytes of new
+ * stream data quic-go puts in a STREAM frame for a stream |stream_id|
+ * at |offset| when |left| bytes of the packet are left: popStreamFrame
+ * is asked with the length of the Length field added to |left|, since
+ * the last STREAM frame of a packet goes without one
+ * (vendor/quic-go/framer.go:442-446), and MaxDataLen sizes the frame
+ * as if it had one of a byte, two when the data is longer than that
+ * (vendor/quic-go/internal/wire/stream_frame.go:136-155).
+ */
+static size_t conn_lc_stream_max_datalen(int64_t stream_id, uint64_t offset,
+                                         size_t ndatalen, size_t left) {
+  size_t max_bytes = left + ngtcp2_put_uvarintlen(left);
+  size_t hdlen = 1 + ngtcp2_put_uvarintlen((uint64_t)stream_id) + 1;
+  size_t n;
+
+  if (offset) {
+    hdlen += ngtcp2_put_uvarintlen(offset);
+  }
+
+  if (hdlen > max_bytes) {
+    return 0;
+  }
+
+  n = max_bytes - hdlen;
+  if (ngtcp2_put_uvarintlen(n) != 1) {
+    --n;
+  }
+
+  return ngtcp2_min(n, ndatalen);
+}
