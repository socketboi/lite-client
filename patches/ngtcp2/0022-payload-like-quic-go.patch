+static size_t conn_lc_rand_below(ngtcp2_conn *conn, size_t n) {
+  uint32_t r, lim = (uint32_t)(0x100000000ULL - 0x100000000ULL % n);
+
+  for (;;) {
+    conn->callbacks.rand((uint8_t *)&r, sizeof(r),
+                         &conn->local.settings.rand_ctx);
+    if (lim == 0 || r < lim) {
+      return r % n;
+    }
+  }
+}
