 /* A path change: ngtcp2 asks the controller to start again. The reference has no such event — a
diff --git a/lib/ngtcp2_rtb.c b/lib/ngtcp2_rtb.c
index 45d4ebc..3614c12 100644
--- a/lib/ngtcp2_rtb.c
+++ b/lib/ngtcp2_rtb.c
@@ -1041,6 +1041,159 @@ static int conn_all_ecn_pkt_lost(ngtcp2_conn *conn) {
          pktns->tx.ecn.validation_pkt_sent == pktns->tx.ecn.validation_pkt_lost;
 }
 
+/*
+ * rtb_detect_lost_pkt_qgo is loss detection as quic-go does it for a
+ * client (detectLostPackets, vendor/quic-go/internal/ackhandler/
+ * sent_packet_handler.go:827-911).  Upstream's differs in four ways,
+ * each of which the client would show:
+ *
+ *   - the packet threshold is packetThreshold, 3 (:25), counted as
+ *     quic-go counts it — the packet numbers skipped in between do not
+ *     count (Difference, vendor/quic-go/internal/ackhandler/
+ *     sent_packet_history.go:248-267).  Upstream raised it with the
+ *     flight, to half the packets in flight and up to 256, so with a
+ *     hundred out it waited for fifty where quic-go waits for three;
+ *   - the lost are declared oldest first, as quic-go walks its history
+ *     (:844), and that is the order their frames go back to the streams
+ *     and the streams into the retransmission queue.  Upstream walked
+ *     newest first;
+ *   - there is no persistent congestion: quic-go has none, and upstream
+ *     reset the RTT estimate and the controller after a loss window of
+ *     three PTOs;
+ *   - hysteria's controller (hybbr) is told of the losses by
+ *     on_pkt_lost and runs them with the ACK or the loss timer, as
+ *     quic-go runs OnCongestionEvent per packet in the same pass
+ *     (:899-901) — so no congestion_event on top, which for hybbr means
+ *     an ECN-CE and nothing else (see ngtcp2_cc_hybbr_congestion_event).
+ *
+ * The loss time is quic-go's too: the oldest packet not yet lost, plus
+ * the loss delay (:882-889).
+ */
+static int rtb_detect_lost_pkt_qgo(ngtcp2_rtb *rtb, ngtcp2_cc_ack *cc_ack,
+                                   ngtcp2_conn *conn, ngtcp2_pktns *pktns,
+                                   ngtcp2_conn_stat *cstat, ngtcp2_tstamp ts) {
+  ngtcp2_rtb_entry *ent, *first = NULL;
+  ngtcp2_duration loss_delay = compute_pkt_loss_delay(cstat);
+  ngtcp2_ksl_it it, last;
+  ngtcp2_cc *cc = rtb->cc;
+  int64_t skipped = 0;
+  size_t ecn_pkt_lost = 0;
+  uint64_t bytes_lost = 0;
+  ngtcp2_tstamp loss_time;
+  ngtcp2_duration pto = ngtcp2_conn_compute_pto(conn, pktns);
+  int rv;
+
+  cstat->loss_time[pktns->id] = UINT64_MAX;
+
+  /* Newest first, to the newest packet that is lost: every packet older
+     than a lost one is lost too, by either threshold. */
+  it = ngtcp2_ksl_lower_bound(&rtb->ents, &rtb->largest_acked_tx_pkt_num);
+  for (; !ngtcp2_ksl_it_end(&it); ngtcp2_ksl_it_next(&it)) {
+    ent = ngtcp2_ksl_it_get(&it);
+
+    if (ent->flags & NGTCP2_RTB_ENTRY_FLAG_LOST_RETRANSMITTED) {
+      break;
+    }
+
+    if (ent->flags & NGTCP2_RTB_ENTRY_FLAG_SKIP) {
+      ++skipped;
+      continue;
+    }
+
+    if (ngtcp2_tstamp_elapsed(ent->ts, loss_delay, ts) ||
+        rtb->largest_acked_tx_pkt_num - ent->hd.pkt_num - skipped >=
+          NGTCP2_PKT_THRESHOLD) {
+      first = ent;
+      break;
+    }
+
+    loss_time = ent->ts + loss_delay;
+    if (loss_time < cstat->loss_time[pktns->id]) {
+      cstat->loss_time[pktns->id] = loss_time;
+    }
+  }
+
+  if (first == NULL) {
+    return 0;
+  }
+
+  /* To the oldest packet of the run, and back up from it. */
+  last = it;
+  for (ngtcp2_ksl_it_next(&it); !ngtcp2_ksl_it_end(&it);
+       ngtcp2_ksl_it_next(&it)) {
+    ent = ngtcp2_ksl_it_get(&it);
+
+    if (ent->flags & NGTCP2_RTB_ENTRY_FLAG_LOST_RETRANSMITTED) {
+      break;
+    }
+
+    last = it;
+  }
+
+  for (it = last;; ngtcp2_ksl_it_prev(&it)) {
+    ent = ngtcp2_ksl_it_get(&it);
+
+    if (ent->hd.pkt_num >= pktns->tx.ecn.start_pkt_num &&
+        (ent->flags & NGTCP2_RTB_ENTRY_FLAG_ECN)) {
+      ++ecn_pkt_lost;
+    }
+
+    bytes_lost += rtb_on_remove(rtb, ent, cstat);
+    rv = rtb_on_pkt_lost(rtb, ent, cstat, conn, pktns, ts);
+    if (rv != 0) {
+      return rv;
+    }
+
+    if (ent == first) {
+      break;
+    }
+  }
+
+  if (bytes_lost) {
+    switch (conn->tx.ecn.state) {
+    case NGTCP2_ECN_STATE_TESTING:
+      if (conn->tx.ecn.validation_start_ts == UINT64_MAX) {
+        break;
+      }
+
+      if (ts - conn->tx.ecn.validation_start_ts < 3 * pto) {
+        pktns->tx.ecn.validation_pkt_lost += ecn_pkt_lost;
+        assert(pktns->tx.ecn.validation_pkt_sent >=
+               pktns->tx.ecn.validation_pkt_lost);
+        break;
+      }
+
+      conn->tx.ecn.state = NGTCP2_ECN_STATE_UNKNOWN;
+
+      /* fall through */
+    case NGTCP2_ECN_STATE_UNKNOWN:
+      pktns->tx.ecn.validation_pkt_lost += ecn_pkt_lost;
+      assert(pktns->tx.ecn.validation_pkt_sent >=
+             pktns->tx.ecn.validation_pkt_lost);
+      if (conn_all_ecn_pkt_lost(conn)) {
+        conn->tx.ecn.state = NGTCP2_ECN_STATE_FAILED;
+      }
+      break;
+    default:
+      break;
+    }
+
+    cc_ack->bytes_lost = bytes_lost;
+
+    if (cc->congestion_event && conn->cc_algo != NGTCP2_CC_ALGO_HYBBR) {
+      cc->congestion_event(cc, cstat, first->ts, cc_ack, ts);
+    }
+  }
+
+  ngtcp2_rtb_remove_excessive_lost_pkt(
+    rtb, (size_t)ngtcp2_min(ngtcp2_max(rtb->cc_bytes_in_flight /
+                                         cstat->max_tx_udp_payload_size / 2,
+                                       NGTCP2_PKT_THRESHOLD),
+                            256));
+
+  return 0;
+}
+
 /*
  * This function assigns the number of bytes lost to
  * |cc_ack|->bytes_lost if any.
@@ -1064,6 +1217,12 @@ static int rtb_detect_lost_pkt(ngtcp2_rtb *rtb, ngtcp2_cc_ack *cc_ack,
   uint64_t bytes_lost = 0;
   ngtcp2_duration max_ack_delay;
 
+  /* A client detects its losses as quic-go does: see
+     rtb_detect_lost_pkt_qgo. */
+  if (!conn->server) {
+    return rtb_detect_lost_pkt_qgo(rtb, cc_ack, conn, pktns, cstat, ts);
+  }
+
   pkt_thres = ngtcp2_max(pkt_thres, NGTCP2_PKT_THRESHOLD);
   pkt_thres = ngtcp2_min(pkt_thres, 256);
   cstat->loss_time[pktns->id] = UINT64_MAX;
