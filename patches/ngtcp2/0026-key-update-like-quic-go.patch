+/*
+ * conn_lc_key_update initiates a key update when quic-go would: its
+ * shouldInitiateKeyUpdate, asked for every packet it seals
+ * (vendor/quic-go/internal/handshake/updatable_aead.go:318-356).  The
+ * first once the handshake is confirmed and 100 packets have been sent
+ * or opened with the first keys, then whenever 100000 have been with
+ * the current ones, and a later one only once a packet sent with the
+ * current keys has been acknowledged.  Keys still being prepared, or
+ * the previous receive key not yet dropped, put it off to the next
+ * packet.
+ */
+static void conn_lc_key_update(ngtcp2_conn *conn) {
+  ngtcp2_pktns *pktns = &conn->pktns;
+  ngtcp2_crypto_km *tx = pktns->crypto.tx.ckm, *rx = pktns->crypto.rx.ckm;
+  uint64_t phase = conn->crypto.key_update.lc_phase;
+
+  if (!(conn->flags & NGTCP2_CONN_FLAG_HANDSHAKE_CONFIRMED) || !tx || !rx) {
+    return;
+  }
+
+  if (phase > 0 &&
+      (tx->use_count == 0 || pktns->rtb.largest_acked_tx_pkt_num < tx->pkt_num)) {
+    return;
+  }
+
+  if (!((phase == 0 && (rx->lc_rcvd >= 100 || tx->use_count >= 100)) ||
+        rx->lc_rcvd >= 100000 || tx->use_count >= 100000)) {
+    return;
+  }
+
+  if (!conn->crypto.key_update.new_tx_ckm ||
+      !conn->crypto.key_update.new_rx_ckm ||
+      conn->crypto.key_update.old_rx_ckm) {
+    return;
+  }
+
+  ngtcp2_log_info(&conn->log, NGTCP2_LOG_EVENT_CRY,
+                  "initiating key update as quic-go does");
+  conn_rotate_keys(conn, NGTCP2_MAX_PKT_NUM, /* initiator = */ 1);
+}
+
 static int conn_initiate_key_update(ngtcp2_conn *conn, ngtcp2_tstamp ts) {
   ngtcp2_tstamp confirmed_ts = conn->crypto.key_update.confirmed_ts;
   ngtcp2_duration pto = ngtcp2_conn_compute_pto(conn, &conn->pktns);
@@ -14043,6 +14090,8 @@
       if (rv != 0) {
         return rv;
