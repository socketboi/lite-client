 }
 
+/*
+ * conn_update_rtt_qgo is quic-go's RTT estimate, for a client (UpdateRTT,
+ * vendor/quic-go/internal/utils/rtt_stats.go:80-116; the cap on the ACK
+ * Delay, vendor/quic-go/internal/ackhandler/sent_packet_handler.go:
+ * 436-439).  The delay is capped at max_ack_delay, 0 until the server's
+ * transport parameters are in, and taken off the sample only when that
+ * leaves it at or above min_rtt; latest_rtt is the sample after that;
+ * the mean deviation and the smoothed RTT move in whole microseconds
+ * through float32.  Upstream kept latest_rtt before the delay, capped
+ * the delay only once the handshake was confirmed and until then
+ * dropped a sample the delay would take below min_rtt, and smoothed in
+ * nanoseconds.  latest_rtt matters beyond the log: loss detection
+ * waits 9/8 of the larger of it and the smoothed RTT.
+ *
+ * Each float32 product is stored through a volatile before the sum, so
+ * that no compiler fuses one into the add: quic-go as built for amd64
+ * rounds every step.  Below about two seconds every step is exact in
+ * float32 anyway, fused or not.
+ */
+static void conn_update_rtt_qgo(ngtcp2_conn *conn, ngtcp2_duration rtt,
+                                ngtcp2_duration ack_delay, ngtcp2_tstamp ts) {
+  ngtcp2_conn_stat *cstat = &conn->cstat;
+  ngtcp2_duration sample = rtt, diff, rttvar;
+  volatile float a, b;
+
+  ack_delay =
+    conn->remote.transport_params
+      ? ngtcp2_min(ack_delay, conn->remote.transport_params->max_ack_delay)
+      : 0;
+
+  if (cstat->first_rtt_sample_ts == UINT64_MAX || cstat->min_rtt > rtt) {
+    cstat->min_rtt = rtt;
+  }
+
+  if (sample - cstat->min_rtt >= ack_delay) {
+    sample -= ack_delay;
+  }
+
+  cstat->latest_rtt = sample;
+
+  if (cstat->first_rtt_sample_ts == UINT64_MAX) {
+    cstat->smoothed_rtt = sample;
+    cstat->rttvar = sample / 2;
+    cstat->first_rtt_sample_ts = ts;
+  } else {
+    diff = cstat->smoothed_rtt < sample ? sample - cstat->smoothed_rtt
+                                        : cstat->smoothed_rtt - sample;
+    a = 0.75f * (float)(cstat->rttvar / NGTCP2_MICROSECONDS);
+    b = 0.25f * (float)(diff / NGTCP2_MICROSECONDS);
+    rttvar = (ngtcp2_duration)(a + b) * NGTCP2_MICROSECONDS;
+    a = (float)(cstat->smoothed_rtt / NGTCP2_MICROSECONDS) * 0.875f;
+    b = (float)(sample / NGTCP2_MICROSECONDS) * 0.125f;
+    cstat->smoothed_rtt = (ngtcp2_duration)(a + b) * NGTCP2_MICROSECONDS;
+    cstat->rttvar = rttvar;
+  }
+
+  ngtcp2_log_infof(&conn->log, NGTCP2_LOG_EVENT_LDC,
+                   "latest_rtt=", cstat->latest_rtt / NGTCP2_MILLISECONDS,
+                   " min_rtt=", cstat->min_rtt / NGTCP2_MILLISECONDS,
+                   " smoothed_rtt=", cstat->smoothed_rtt / NGTCP2_MILLISECONDS,
+                   " rttvar=", cstat->rttvar / NGTCP2_MILLISECONDS,
+                   " ack_delay=", ack_delay / NGTCP2_MILLISECONDS);
+}
+
 void ngtcp2_conn_update_rtt(ngtcp2_conn *conn, ngtcp2_duration rtt,
                             ngtcp2_duration ack_delay, ngtcp2_tstamp ts) {
   ngtcp2_conn_stat *cstat = &conn->cstat;
 
   assert(rtt > 0);
 
+  /* A client estimates as quic-go does: see conn_update_rtt_qgo. */
+  if (!conn->server) {
+    conn_update_rtt_qgo(conn, rtt, ack_delay, ts);
+    return;
+  }
+
   if (cstat->min_rtt == UINT64_MAX) {
     cstat->latest_rtt = rtt;
     cstat->min_rtt = rtt;
