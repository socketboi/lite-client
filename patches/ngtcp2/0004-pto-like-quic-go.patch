+/*
+ * conn_scale_pto applies the PTO backoff, capped as quic-go caps it:
+ * `pto := h.rttStats.PTO(...) << h.ptoCount; if pto > maxPTODuration
+ * || pto <= 0 { return maxPTODuration }`, maxPTODuration being 60
+ * seconds (vendor/quic-go/internal/ackhandler/sent_packet_handler.go:
+ * 30-31, :677-683).  ngtcp2 shifts without a ceiling and caps the
+ * count at 30 instead, which is 2^30 of them.
+ */
+static ngtcp2_duration conn_scale_pto(ngtcp2_duration pto, size_t pto_count) {
+  size_t i;
+
+  for (i = 0; i < pto_count; ++i) {
+    if (pto > NGTCP2_MAX_PTO / 2) {
+      return NGTCP2_MAX_PTO;
+    }
+
+    pto *= 2;
+  }
+
+  return ngtcp2_min(pto, NGTCP2_MAX_PTO);
+}
