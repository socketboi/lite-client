+/*
+ * conn_reverse_bytes reverses the |len| bytes starting at |p|.
+ */
+static void conn_reverse_bytes(uint8_t *p, size_t len) {
+  uint8_t *q = p + len;
+  uint8_t c;
+
+  for (; p < --q; ++p) {
+    c = *p;
+    *p = *q;
+    *q = c;
+  }
+}
+
+/*
+ * conn_write_deferred_initial writes the Initial packet of a datagram
+ * whose other packets are already written in |dest| and occupy
+ * |taillen| bytes, and then moves it in front of them.  |destlen| is
+ * the length of the datagram this endpoint may write.
+ *
+ * The Initial packet is written last because it carries the padding of
+ * the whole datagram, and how much padding that is only becomes known
+ * once everything behind it has been written.  quic-go composes the
+ * datagram the same way round: it packs the payloads of all the
+ * packets first, and the Initial packet it writes in front of them is
+ * given maxPacketSize minus the size of all of them
+ * (vendor/quic-go/packet_packer.go:347-356, :373-441, :470-472).
+ *
+ * This function returns the length of the datagram, or one of the
+ * following negative error codes:
+ *
+ * NGTCP2_ERR_NOMEM
+ *     Out of memory.
+ * NGTCP2_ERR_CALLBACK_FAILURE
+ *     User-defined callback function failed.
+ */
+static ngtcp2_ssize conn_write_deferred_initial(ngtcp2_conn *conn,
+                                                ngtcp2_pkt_info *pi,
+                                                uint8_t *dest, size_t destlen,
+                                                size_t taillen,
+                                                ngtcp2_tstamp ts) {
+  ngtcp2_ssize nwrite;
+  int handshake_written;
+
+  assert(!conn->server);
+
+  /* A Path MTU Discovery probe is written past the size the path is
+     known to take, so what is already in the buffer can be longer than
+     this datagram; there is then no room to lead it with anything. */
+  if (conn->in_pktns == NULL || taillen >= destlen) {
+    return (ngtcp2_ssize)taillen;
+  }
+
+  /* Read before the Initial packet is written, while the packet behind
+     it still begins the buffer. */
+  handshake_written =
+    taillen && (dest[0] & NGTCP2_HEADER_FORM_BIT) &&
+    ngtcp2_pkt_get_type_long(conn->negotiated_version
+                               ? conn->negotiated_version
+                               : conn->client_chosen_version,
+                             dest[0]) == NGTCP2_PKT_HANDSHAKE;
+
+  nwrite = conn_write_handshake_pkt(conn, pi, dest + taillen, destlen - taillen,
+                                    taillen, NGTCP2_PKT_INITIAL,
+                                    NGTCP2_WRITE_PKT_FLAG_PAD_LEADING_INITIAL,
+                                    /* write_datalen = */ 0, ts);
+  if (nwrite < 0) {
+    assert(nwrite != NGTCP2_ERR_NOBUF);
+
+    return nwrite;
+  }
+
+  if (nwrite == 0) {
+    return (ngtcp2_ssize)taillen;
+  }
+
+  /* Coalesced packets go in increasing order of encryption level (RFC
+     9000, Section 12.2), so the Initial packet leads the datagram. */
+  conn_reverse_bytes(dest, taillen);
+  conn_reverse_bytes(dest + taillen, (size_t)nwrite);
+  conn_reverse_bytes(dest, taillen + (size_t)nwrite);
+
+  if (handshake_written && conn->hs_pktns->crypto.tx.ckm) {
+    /* The discard that conn_write_handshake_pkts left to this
+       function: a Handshake packet went out in this datagram, so no
+       further Initial packet is needed. */
+    ngtcp2_conn_discard_initial_state(conn, ts);
+  }
+
+  return (ngtcp2_ssize)(taillen + (size_t)nwrite);
+}
