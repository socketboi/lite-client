 /**
+ * @struct
+ *
+ * :type:`ngtcp2_rx1rtt_keys` is what a 1-RTT packet from the peer is
+ * opened with at this moment, as `conn_recv_pkt` finds it for a short
+ * header whose Key Phase bit has not changed: the key, its IV and its
+ * phase, the header protection context, the largest packet number
+ * received so far, against which a truncated one is decoded, and the
+ * length of the Destination Connection ID a short header carries.
+ * The pointers point into |conn| and are good until the next call
+ * into it.
+ */
+typedef struct ngtcp2_rx1rtt_keys {
+  const ngtcp2_crypto_aead_ctx *aead_ctx;
+  const ngtcp2_crypto_cipher_ctx *hp_ctx;
+  const uint8_t *iv;
+  size_t ivlen;
+  int key_phase;
+  int64_t max_pkt_num;
+  size_t dcidlen;
+} ngtcp2_rx1rtt_keys;
+
+/**
+ * @function
+ *
+ * `ngtcp2_conn_get_rx1rtt_keys` fills |keys| as
+ * :type:`ngtcp2_rx1rtt_keys` describes, and returns 0; before the
+ * 1-RTT keys are installed it returns -1 and leaves |keys| untouched.
+ * It changes nothing: it only lets a caller open the peer's next
+ * packets ahead of `ngtcp2_conn_read_pkt`, with the same key and the
+ * same packet number the library will use, so that the decrypt and
+ * hp_mask callbacks can answer with what was computed.
+ */
+NGTCP2_EXTERN int ngtcp2_conn_get_rx1rtt_keys(const ngtcp2_conn *conn,
+                                              ngtcp2_rx1rtt_keys *keys);
