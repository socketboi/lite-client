+int ngtcp2_conn_get_rx1rtt_keys(const ngtcp2_conn *conn,
+                                ngtcp2_rx1rtt_keys *keys) {
+  const ngtcp2_pktns *pktns = &conn->pktns;
+  const ngtcp2_crypto_km *ckm = pktns->crypto.rx.ckm;
+
+  if (!ckm || !pktns->crypto.rx.hp_ctx.native_handle) {
+    return -1;
+  }
+
+  /* What conn_recv_pkt takes for a short header when
+     conn_key_phase_changed is false: pktns->crypto.rx.ckm and
+     pktns->crypto.rx.hp_ctx, the packet number adjusted against
+     pktns->acktr.max_pkt_num, and a short header decoded with
+     conn->oscid.datalen. */
+  keys->aead_ctx = &ckm->aead_ctx;
+  keys->hp_ctx = &pktns->crypto.rx.hp_ctx;
+  keys->iv = ckm->iv.base;
+  keys->ivlen = ckm->iv.len;
+  keys->key_phase = (ckm->flags & NGTCP2_CRYPTO_KM_FLAG_KEY_PHASE_ONE) != 0;
+  keys->max_pkt_num = pktns->acktr.max_pkt_num;
+  keys->dcidlen = conn->oscid.datalen;
+
+  return 0;
+}
