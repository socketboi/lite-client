+      !ngtcp2_strm_streamfrq_empty(strm) &&
+      ngtcp2_strm_streamfrq_unacked_offset(strm) == 0) {
+    for (it = ngtcp2_ksl_begin(strm->tx.streamfrq); !ngtcp2_ksl_it_end(&it);
+         ngtcp2_ksl_it_next(&it)) {
+      frc = ngtcp2_ksl_it_get(&it);
+      pending += ngtcp2_vec_len(frc->fr.stream.data, frc->fr.stream.datacnt);
+    }
