+      rv = ngtcp2_strm_streamfrq_pop(strm, &frc, (size_t)first);
+      if (rv != 0) {
+        return rv;
+      }
+      rv = ngtcp2_strm_streamfrq_pop(strm, &rest, (size_t)(pending - first));
+      if (rv != 0) {
