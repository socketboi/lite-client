+/* The most CRYPTO frames one Initial packet carries under the parrot:
+   what it is packed with, and up to ten cuts of them. */
+#define NGTCP2_CHROME_MAX_CRYPTO 32
+
+/* One element of the shuffled payload (chaosItem,
+   vendor/quic-go/packet_packer_chaos.go:87-92): a CRYPTO piece, a
+   PING, or a run of padding. */
+/* The vectors one piece may span.  CRYPTO in an Initial packet is one
+   or two submitted buffers; a frame spanning more is written without
+   being cut. */
+#define NGTCP2_CHROME_ITEM_DATACNT 8
+
+typedef struct ngtcp2_chrome_item {
+  int kind; /* 0 CRYPTO piece, 1 PING, 2 padding */
+  uint64_t offset;
+  size_t datacnt;
+  ngtcp2_vec data[NGTCP2_CHROME_ITEM_DATACNT];
+  size_t padlen;
+} ngtcp2_chrome_item;
+
+/*
+ * conn_chrome_initial_crypto packs and writes the CRYPTO of one Initial
+ * packet the way hysteria's client does while it parrots Chrome.
+ *
+ * Packing: the first packet of a ClientHello too large for one carries
+ * its head and its tail (chromeCryptoSplit, with the pops at
+ * vendor/quic-go/packet_packer.go:625-646), the middle left in the
+ * queue for the packets after it; any other packet takes CRYPTO frames
+ * in offset order while they fit (:647-657).
+ *
+ * Writing: when the packet is to be padded, the payload is chaos
+ * protected (appendChaosProtectedPayload,
+ * vendor/quic-go/packet_packer_chaos.go:94-165, entered at
+ * packet_packer.go:976-977): the CRYPTO frames cut at random points,
+ * two to ten PINGs, the padding in runs, all of it shuffled, the
+ * packet exactly the size it would have been.  Without padding the
+ * frames are shuffled and written (appendPacketPayload, :1054-1080).
+ *
+ * The frames written are pieces; what goes to loss recovery through
+ * |*pfrc| is the frames as packed, as quic-go hands its ackhandler the
+ * unshredded ones.  |*ppadding| receives the padding the packet
+ * carried, or (size_t)-1 when it wrote none and the caller pads.
+ * Returns the number of frames packed, or a negative error.
+ */
