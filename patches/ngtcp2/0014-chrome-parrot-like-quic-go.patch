+                                               ngtcp2_ppe *ppe,
+                                               ngtcp2_pkt_hd *hd,
+                                               int *phd_logged,
+                                               ngtcp2_pktns *pktns,
+                                               ngtcp2_frame_chain **pfrc,
+                                               size_t *ppadding) {
+  ngtcp2_strm *strm = &pktns->crypto.strm;
+  ngtcp2_frame_chain *frames[NGTCP2_CHROME_MAX_CRYPTO];
+  ngtcp2_frame_chain *frc, *rest, *mid, *tail, **pnext;
+  ngtcp2_chrome_item items[NGTCP2_CHROME_MAX_CRYPTO * 2 + 16];
+  int cuttable = 1;
+  size_t nframes = 0, nitems = 0, npieces, i, j;
+  uint64_t left = ngtcp2_ppe_left(ppe), pending = 0, first, last, datalen;
+  uint64_t payloadlen = 0, budget, lo, hi, max_overhead, attempts, npings;
+  uint64_t crypto_offset, cut, restlen, target;
+  ngtcp2_ksl_it it;
+  ngtcp2_frame fr;
+  ngtcp2_chrome_item t;
+  int rv;
+
+  *pfrc = NULL;
+  *ppadding = 0;
+
+  /* The split, for a ClientHello none of which has been sent. */
