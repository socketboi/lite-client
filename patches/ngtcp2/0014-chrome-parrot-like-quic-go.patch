+/* ---- the Initial packet of a client parroting Chrome ------------------- */
+
+/* chrome_rand_n draws uniformly from [0, n), rejecting as Go's IntN
+   does (math/rand/v2, Lemire's method), from the connection's PRNG,
+   which is seeded from the rand callback as quic-go's packer seeds its
+   PCG from crypto/rand (vendor/quic-go/packet_packer.go:176-180). */
+static uint32_t chrome_rand_n(ngtcp2_conn *conn, uint32_t n) {
+  uint64_t m = (uint64_t)ngtcp2_pcg32_rand(&conn->pcg) * n;
+  uint32_t lo = (uint32_t)m;
+
+  if (lo < n) {
+    uint32_t thresh = (uint32_t)(-n) % n;
+
+    while (lo < thresh) {
+      m = (uint64_t)ngtcp2_pcg32_rand(&conn->pcg) * n;
+      lo = (uint32_t)m;
+    }
+  }
+
+  return (uint32_t)(m >> 32);
+}
+
+/* cryptoFrameHeaderLen (vendor/quic-go/packet_packer_chaos.go:80-85). */
+static uint64_t chrome_crypto_hdlen(uint64_t offset, uint64_t datalen) {
+  return 1 + ngtcp2_put_uvarintlen(offset) + ngtcp2_put_uvarintlen(datalen);
+}
+
+/*
+ * chrome_crypto_split is chromeCryptoSplit
+ * (vendor/quic-go/packet_packer_chaos.go:38-78): for a ClientHello too
+ * large for one Initial packet, the length of the leading frame and of
+ * the trailing one, both of which the first packet carries; zero for
+ * both when no split is due.
+ */
+static void chrome_crypto_split(ngtcp2_conn *conn, uint64_t pending,
+                                uint64_t offset, uint64_t available,
+                                uint64_t *pfirst, uint64_t *plast) {
+  uint64_t min_frame, max_first, max_other, occupied, npkts, data_other;
+  uint64_t data_first, first;
+
+  *pfirst = *plast = 0;
+
+  if (pending == 0 || available == 0) {
+    return;
+  }
+
+  min_frame = chrome_crypto_hdlen(offset + pending - 1, pending);
+  if (available < 2 * min_frame) {
+    return;
+  }
+
+  max_first = available - 2 * min_frame;
+  max_other = available - min_frame;
+  if (pending <= max_first) {
+    return;
+  }
+
+  occupied = max_other - max_first;
+  npkts = (pending + occupied + max_other - 1) / max_other;
+  data_other = (pending + occupied + npkts - 1) / npkts;
+  if (data_other < occupied) {
+    return;
+  }
+
+  data_first = data_other - occupied;
+  first = 55 + chrome_rand_n(conn, 32);
+  if (pending <= first || data_first <= first) {
+    return;
+  }
+
+  *pfirst = first;
+  *plast = data_first - first;
+}
+
+/*
+ * chrome_vec_slice copies into |dst| the vectors that cover bytes
+ * [|from|, |to|) of the data |src| describes, and returns how many it
+ * wrote, or 0 when they do not fit |maxcnt|.
+ */
+static size_t chrome_vec_slice(ngtcp2_vec *dst, size_t maxcnt,
+                               const ngtcp2_vec *src, size_t srccnt,
+                               uint64_t from, uint64_t to) {
+  size_t i, n = 0;
+  uint64_t pos = 0, a, b;
+
+  for (i = 0; i < srccnt && pos < to; pos += src[i].len, ++i) {
+    if (pos + src[i].len <= from) {
+      continue;
+    }
+
+    a = from > pos ? from - pos : 0;
+    b = ngtcp2_min(to - pos, (uint64_t)src[i].len);
+
+    if (n == maxcnt) {
+      return 0;
+    }
+
+    dst[n].base = src[i].base + a;
+    dst[n].len = (size_t)(b - a);
+    ++n;
+  }
+
+  return n;
+}
+
+/*
+ * chrome_crypto_chain makes a CRYPTO frame chain for bytes [|from|,
+ * |to|) of |fr|.
+ */
+static int chrome_crypto_chain(ngtcp2_conn *conn, ngtcp2_frame_chain **pfrc,
+                               const ngtcp2_stream *fr, uint64_t from,
+                               uint64_t to) {
+  ngtcp2_vec v[NGTCP2_MAX_STREAM_DATACNT];
+  size_t n = chrome_vec_slice(v, NGTCP2_MAX_STREAM_DATACNT, fr->data,
+                              fr->datacnt, from, to);
+  ngtcp2_stream *nfr;
+  int rv;
+
+  if (n == 0) {
+    return NGTCP2_ERR_NOMEM;
+  }
+
+  rv = ngtcp2_frame_chain_stream_datacnt_objalloc_new(pfrc, n,
+                                                      &conn->frc_objalloc,
+                                                      conn->mem);
+  if (rv != 0) {
+    return rv;
+  }
+
+  nfr = &(*pfrc)->fr.stream;
+  nfr->type = NGTCP2_FRAME_CRYPTO;
+  nfr->flags = 0;
+  nfr->fin = 0;
+  nfr->stream_id = 0;
+  nfr->offset = fr->offset + from;
+  nfr->datacnt = n;
+  ngtcp2_vec_copy(nfr->data, v, n);
+
+  return 0;
+}
