+/* SkipPacketInitialPeriod (vendor/quic-go/internal/protocol/params.go:47). */
+#define NGTCP2_QGO_SKIP_INITIAL_PERIOD 256
+
+/*
+ * conn_qgo_update_skip_pkt is quic-go's skippingPacketNumberGenerator
+ * for a client's 1-RTT packets (vendor/quic-go/internal/ackhandler/
+ * packet_number_generator.go:36-84, started at 0 by newPacketNumberSpace,
+ * vendor/quic-go/internal/ackhandler/sent_packet_handler.go:54-66, :169).
+ * The next number left out is the next one to be used, plus 3, plus a
+ * draw below twice the period; the period starts at
+ * SkipPacketInitialPeriod, 256, and doubles after each draw up to
+ * SkipPacketMaxPeriod, 128 Ki (vendor/quic-go/internal/protocol/
+ * params.go:45-50).  The draw is utils.Rand's Int31n, which for a power
+ * of two is four bytes from crypto/rand, big-endian, masked
+ * (vendor/quic-go/internal/utils/rand.go:13-29), and the rand callback
+ * is this client's crypto/rand.  The next number to be used is 0 at the
+ * start, and after a skip the one after the packet that takes the
+ * skipped number's place.  Upstream put the next skip (r + 1) * 2^k + 3
+ * on, for one random byte r and a k growing from 0 without a ceiling.
+ * |exponent| counts the doublings here.
+ */
+static void conn_qgo_update_skip_pkt(ngtcp2_conn *conn, ngtcp2_pktns *pktns) {
+  int64_t period = (int64_t)NGTCP2_QGO_SKIP_INITIAL_PERIOD
+                   << ngtcp2_min(pktns->tx.skip_pkt.exponent, 9);
+  int64_t next =
+    pktns->tx.last_pkt_num + (pktns->tx.skip_pkt.exponent ? 2 : 1);
+  uint8_t b[4];
+  uint32_t v;
+
+  conn->callbacks.rand(b, sizeof(b), &conn->local.settings.rand_ctx);
+  ngtcp2_get_uint32be(&v, b);
+  v &= (uint32_t)(2 * period - 1);
+  ++pktns->tx.skip_pkt.exponent;
+
+  if (next > NGTCP2_MAX_PKT_NUM - 3 - (int64_t)v) {
+    pktns->tx.skip_pkt.next_pkt_num = INT64_MAX;
+    return;
+  }
+
+  pktns->tx.skip_pkt.next_pkt_num = next + 3 + (int64_t)v;
+
+  ngtcp2_log_infof(&conn->log, NGTCP2_LOG_EVENT_CON,
+                   "next skip pkn=", pktns->tx.skip_pkt.next_pkt_num);
+}
