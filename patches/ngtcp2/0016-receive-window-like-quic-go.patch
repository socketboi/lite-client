+/*
+ * conn_qgo_has_window_update is quic-go's hasWindowUpdate
+ * (vendor/quic-go/flow_controller_base.go:35-39): an update is due once
+ * what is left of the advertised window has fallen to three quarters
+ * of the window's size, WindowUpdateThreshold being 0.25
+ * (vendor/quic-go/internal/protocol/params.go:31).  |inc| is what was
+ * read since the last advertisement, which leaves |window| - |inc|.
+ * Upstream waited for more than a quarter to be read, one byte longer.
+ */
+static int conn_qgo_has_window_update(uint64_t window, uint64_t inc) {
+  /* Nothing read, nothing to announce; this also keeps a stream that
+     cannot receive, whose window is 0, from announcing one. */
+  if (inc == 0) {
+    return 0;
+  }
+
+  if (inc >= window) {
+    return 1;
+  }
+
+  return window - inc <= (uint64_t)((double)window * (1 - 0.25));
+}
