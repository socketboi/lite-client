+/*
+ * conn_qgo_ensure_min_window is quic-go's EnsureMinimumWindowSize
+ * (vendor/quic-go/flow_controller_connection.go:150-165), which a
+ * stream whose window has just grown calls
+ * (vendor/quic-go/flow_controller_stream.go:186-195): the connection's
+ * window is raised to ConnectionFlowControlMultiplier (1.5,
+ * vendor/quic-go/internal/protocol/params.go:16) times the stream's,
+ * as far as its own ceiling allows, and its epoch starts over — unless
+ * it was that large already.  What may be advertised next moves with
+ * the window, so that it stays what was read plus the window.
+ */
+static void conn_qgo_ensure_min_window(ngtcp2_conn *conn,
+                                       uint64_t strm_window,
+                                       ngtcp2_tstamp ts) {
+  uint64_t inc = (uint64_t)((double)strm_window * 1.5);
+  uint64_t size;
 
-  return conn->rx.window < 4 * inc;
+  if (inc <= conn->rx.window) {
+    return;
+  }
+
+  size = ngtcp2_min(inc, conn->local.settings.max_window);
+  if (size > conn->rx.window) {
+    conn->rx.unsent_max_offset += size - conn->rx.window;
+    conn->rx.window = size;
+  }
+
+  conn->rx.epoch_ts = ts;
+  conn->rx.epoch_offset = conn->rx.unsent_max_offset - conn->rx.window;
+}
