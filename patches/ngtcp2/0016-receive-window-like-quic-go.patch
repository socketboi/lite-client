+/*
+ * conn_qgo_adjust_window is quic-go's maybeAdjustWindowSize
+ * (vendor/quic-go/flow_controller_base.go:55-75), run where quic-go
+ * runs it, as the window update is written (:43-51): when more than
+ * half of the window was read in the current epoch, and in less than
+ * four times that fraction of the smoothed RTT, the window doubles up
+ * to |max_window|; either way a new epoch begins.  Less than half read
+ * leaves the epoch running, and so does a smoothed RTT of zero — which
+ * is not the state before the first sample: quic-go's NewRTTStats
+ * starts it at DefaultInitialRTT, 100 ms
+ * (vendor/quic-go/internal/utils/rtt_stats.go:32-38), and ngtcp2 at the
+ * initial_rtt the client sets to the same.  This said otherwise until
+ * the reference's code was run (tools/qgovec).  |bytes_read| is what
+ * the application has read, which ngtcp2 keeps as the offset it
+ * would advertise next less the window.  It returns the window's new
+ * size.
+ */
+static uint64_t conn_qgo_adjust_window(const ngtcp2_conn *conn,
+                                       uint64_t window, uint64_t bytes_read,
+                                       ngtcp2_tstamp *epoch_ts,
+                                       uint64_t *epoch_offset,
+                                       uint64_t max_window, ngtcp2_tstamp ts) {
+  uint64_t in_epoch = bytes_read - *epoch_offset;
+  double fraction;
+
+  if (in_epoch <= window / 2 || conn->cstat.smoothed_rtt == 0) {
+    return window;
+  }
+
+  fraction = (double)in_epoch / (double)window;
+  if (ts - *epoch_ts < (ngtcp2_duration)(4 * fraction *
+                                         (double)conn->cstat.smoothed_rtt) &&
+      max_window > window) {
+    window = ngtcp2_min(2 * window, max_window);
+  }
+
+  *epoch_ts = ts;
+  *epoch_offset = bytes_read;
+
+  return window;
+}
