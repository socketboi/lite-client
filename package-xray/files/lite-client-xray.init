#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

LAUNCHER=/usr/bin/lc-xray
ASSETS=/usr/share/lite-client-xray
CONF=/etc/config/lite-client-xray

extra_command 'check' 'Validate the configured Xray JSON files'

read_config_directory() {
	config_get directory main config_dir
	case "$directory" in
		/*) return 0 ;;
		*) echo 'lite-client-xray: config_dir must be an absolute directory.' >&2; return 1 ;;
	esac
}

check() {
	local directory
	config_load lite-client-xray || return 1
	read_config_directory || return 1
	XRAY_LOCATION_ASSET="$ASSETS" "$LAUNCHER" check --confdir "$directory"
}

start_service() {
	local enabled directory file
	config_load lite-client-xray || exit 1
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	read_config_directory || exit 1
	if ! XRAY_LOCATION_ASSET="$ASSETS" "$LAUNCHER" check --confdir "$directory" >/dev/null 2>&1; then
		echo 'lite-client-xray: validation failed. Run /etc/init.d/lite-client-xray check.' >&2
		exit 1
	fi

	procd_open_instance xray
	procd_set_param command "$LAUNCHER" run --confdir "$directory"
	procd_set_param env "XRAY_LOCATION_ASSET=$ASSETS"
	procd_set_param file "$CONF" "$LAUNCHER" /usr/libexec/lite-client-xray/xray
	for file in "$directory"/.* "$directory"/*; do
		case "${file##*/}" in
			?*.json|?*.jsonc) [ ! -f "$file" ] || procd_append_param file "$file" ;;
		esac
	done
	procd_set_param respawn 3600 5 3
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger lite-client-xray
}
