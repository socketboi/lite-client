# Configuration for lite-client. Read by /etc/init.d/lite-client.
#
# Nothing here is a secret except by reference: the account and the passwords live in files of their
# own, named below. A command line is readable through /proc by every process on the machine, and
# procd keeps a copy of it besides — visible in `ubus call service list` for as long as the
# service runs.
#
# Those paths are written down twice: here, and in the package's conffiles, which is the list of
# what survives a sysupgrade. Point one of them somewhere else and the router comes back from a
# firmware upgrade without its credential; the service says so in syslog at startup, because it is
# the only place that can see both lists at once.

config lite-client 'main'
	option enabled       '0'

	# Which plane carries the traffic: 'reality' or 'hysteria'.
	#
	# lite-client builds REALITY only; lite-client-hysteria includes both planes.
	# Asking for 'hysteria' from the plain package is answered
	# by the tunnel refusing to start and saying so, rather than by a service that runs and carries
	# nothing.
	#
	# The Hysteria2 half of this file did not exist. The plane was written, tested against a live
	# node and packaged, and the only way to run it on a router was to stop the service and type the
	# command line by hand — which also meant the certificate pin, the one thing that says WHICH node
	# answered, could not be turned on at all where it matters.
	option plane         'reality'

	# The node, as an address or a name. The REALITY plane looks a name up for every dial, as Xray
	# does; the Hysteria2 plane once at start, as the hysteria client does — see "Known limitations" in
	# docs/DESIGN.md.
	option node          ''
	option port          '443'

	# The name the handshake claims. REALITY requires it to match the node's configuration; on the
	# Hysteria2 plane it is the name in the certificate the node presents.
	option sni           ''

	# --- the REALITY plane ---------------------------------------------------

	option public_key    ''
	option short_id      ''

	# Mode 0600, owned by whoever the service runs as, which is root. That is checked rather than
	# wished for: lc-tunnel refuses a file that is not a regular file, one that belongs to somebody
	# else, and one readable beyond its owner, and it does not follow a symbolic link left in place of
	# it — otherwise whoever put the link there chooses which file's first line the node is handed
	# instead of the secret. The service does not start if the file cannot be read.
	option uuid_file     '/etc/lite-client/uuid'

	# XTLS-Vision, which is the thing REALITY is taken for. Without it a SECOND TLS runs inside the
	# tunnel, and "the record outside is about the size of the record inside" identifies the
	# connection from one stream. The default is what an Xray server's user with Vision carries.
	#
	# 'xtls-rprx-vision-udp443' is Vision with Xray's allowUDP443, and is passed through as written.
	# 'none' is a deliberate refusal of Vision: plain VLESS. An empty value means the default, not
	# 'none' — UCI does not tell the two apart. Anything else is refused and the service does not
	# start, because reading an unknown value as "no Vision" would happen silently.
	option flow          'xtls-rprx-vision'

	# --- UDP, on either plane -------------------------------------------------

	# Where the second listener waits, for UDP. Empty means UDP is not intercepted at all, and that
	# shows: QUIC then travels beside the tunnel rather than through it, so a browser goes straight
	# out wherever it is allowed to. The intercept rule is added only together with this option.
	# Both native planes use distinct transparent TCP and UDP listeners.
	option udp_port      '19100'

	# --- moving the flow, on the Hysteria2 plane -----------------------------

	# Seconds between port hops, when `port` below is written as a range; empty means the reference's
	# own 30 seconds. With a single port nothing hops, as with the reference client, and the tunnel
	# says so at startup.
	#
	# Each hop opens a new socket on a new local port and sends to a new port of the range, so the
	# flow a shaper keyed its state on is a new one. The node needs only the redirect described at
	# `port` — QUIC recognises a connection by its identifier, not by where it came from.
	#
	# Every hop costs whatever the node had in flight to the old port, so shorter is not
	# automatically better. Five is the floor, because upstream refuses to go below it ("hop
	# interval must be at least 5 seconds"); a smaller value stops the service rather than starting
	# it with hopping quietly off.
	option hop_seconds   ''

	# Gecko, written as the two datagram sizes the NODE was configured with: `gecko '512-1200'`,
	# which are also the reference client's own defaults.
	#
	# It is the second obfuscation, and it wraps Salamander rather than replacing it: every packet
	# of the handshake is cut into two to eight datagrams of random size, so that the shape of a
	# handshake — which XOR leaves untouched — stops being recognisable. Only the handshake; the
	# traffic afterwards goes whole.
	#
	# Set it when and only when the node runs it. A node with Gecko on drops every long-header
	# datagram that is not a Gecko frame, and a node without it drops every one that is: either way
	# the handshake never completes and the log blames the path.
	option gecko         ''

	# Chrome's QUIC stack, parroted: the hello, the transport parameters, the connection IDs and the
	# layout of the first packets are Chrome's, as hysteria's own client makes them unless its config
	# says quic.disableChromeParrot. Empty or '1' parrots; '0' is that disableChromeParrot. The node
	# accepts either — it is the path that sees the difference.
	option chrome_parrot ''

	# The node's port may also be written as a range — `port '20000-50000'` — and then the far end
	# moves too, which is what upstream calls port hopping. That form needs one firewall rule on the
	# node redirecting the range to the single port it already listens on, and nothing else.
	# Without such a rule the range is useless. With a single port nothing hops at all, whatever
	# hop_seconds says: the reference client hops only over a range.

	# --- the Hysteria2 plane -------------------------------------------------

	# The account password, in a file for the same reason the uuid is: it is the whole credential.
	# Mode 0600, owned by root — the same requirements as uuid_file above, checked the same way.
	option auth_file     '/etc/lite-client/auth'

	# The same written out, for a one-off test and nothing else. Out of /proc it goes almost at once,
	# since lc-tunnel overwrites the argument as soon as it has read it — but procd keeps its OWN
	# copy of the command line for the life of the instance, and that one is visible in
	# `ubus call service list` until the service stops. Set, it wins over auth_file.
	option auth          ''

	# The obfuscation password, when the node runs Salamander. Empty means the node runs none — which
	# has to be stated rather than guessed, because getting it wrong looks identical from here: a node
	# that never answers and never says why. The same secret gates the node's whole UDP port, so it
	# has a file form too, preferred for exactly the reasons auth_file is.
	option obfs_file     '/etc/lite-client/obfs'

	# The same written out. Set, it wins over obfs_file — and lands in procd's copy of the command
	# line for as long as the service runs, just as auth does.
	option obfs          ''

	# What we tell the node we can receive at, in BYTES per second, and it is the one number in this
	# protocol that decides how fast anything goes: state it and the node sends at that rate whatever
	# the path between us is doing. Hysteria's own config writes "100 mbps"; that is 12500000 here.
	# Empty means we state nothing and the node uses ordinary congestion control.
	option rate          ''

	# The SHA-256 of the node's certificate in DER, as hex. Required: the reference verifies the
	# node's certificate and this client cannot, so the pin is the only evidence of WHICH node answered
	# (a QUIC handshake proves the peer can do key exchange, which an interceptor can also do). Left
	# empty, the service does not start; '-' runs without it, on purpose and with a warning. On the
	# node:
	#
	#   openssl x509 -in cert.pem -outform der | sha256sum
	option pin           ''

	# Where the transparent listener waits. Not reachable from the LAN: the rules send traffic
	# to it, nobody connects to it directly.
	option listen_port   '19099'

	# How many copies of the tunnel share that listener: a number 1 to 8, or 'auto' for one per
	# CPU the kernel reports. Empty leaves it to the client, which since 2026-09-23 means 'auto' on
	# the REALITY plane (the reference's own default, Go using every CPU) and one on Hysteria2, where
	# copies sharing an auth evict each other at a node that keeps one session per account. '1' means
	# one on either.
	#
	# On Hysteria2 it takes ONLY 1 (or empty): every copy would open its own session with the same
	# password, and a node that allows one session per account closes all but the newest — so the
	# service refuses any other value on that plane rather than start a tunnel made of 0x107 closes.
	#
	# On REALITY, 'auto' is the value for a configuration that goes to many routers: it reaches a box
	# with two cores and a box with four, and a number picked for one is wrong on the other — too few
	# wastes a core, too many cost buffers for nothing.
	#
	# It splits CONNECTIONS between cores, not one download — a single stream lives in one worker
	# from beginning to end and is exactly as fast as before. A household with many connections
	# open at once is what gains, and the ceiling is the number of cores the box actually has.
	#
	# With more than one, the parent stops carrying traffic and supervises: a worker that dies is
	# replaced without procd needing to know, and killing the parent takes all of them.
	option workers       ''

	# Whose traffic is intercepted — addresses or prefixes, separated by spaces. Empty means
	# nobody, which is the safe default: a router that intercepts everything the moment it is
	# installed is a router that breaks a household before anyone has configured it.
	#
	#   list clients '192.168.1.0/24'
	#   list clients '192.168.1.50'
	list clients ''
