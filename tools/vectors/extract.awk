# Turn the RFC 8448 "Simple 1-RTT Handshake" trace into C test vectors.
#
# The key schedule is the one part of TLS 1.3 that can be proved right without a server: RFC 8448
# prints every input and every output of every derivation. Transcribing those by hand is exactly the
# kind of work that introduces a typo nobody ever finds, so they are extracted mechanically instead.
#
#   awk -f extract.awk rfc8448.txt > ../../src/test_vectors.h
#
# Only section 3 is read. Each block looks like
#
#   {server}  extract secret "handshake":
#      salt (32 octets):  6f 26 ...
#      IKM (32 octets):  8b d4 ...
#      secret (32 octets):  1d c8 ...
#
# and becomes one C array per field. Blocks that only say "same as server" carry no octets and are
# skipped: they repeat a value already emitted.

function flush_field(  n) {
    if (field == "" || hex == "")
        return
    # A zero-length field is printed as "(empty)" — the finished-key derivation has one, because its
    # context is deliberately empty. C has no empty array, and an absent symbol is the honest
    # representation: a test that wants an empty context passes NULL and a length of zero.
    if (hex ~ /\(empty\)/) {
        field = ""
        hex = ""
        return
    }
    printf "static const uint8_t %s_%s[] = {", block, field
    n = split(hex, byte_list, " ")
    for (i = 1; i <= n; i++)
        printf "%s0x%s", (i == 1 ? "" : ","), byte_list[i]
    printf "};\n"
    field = ""
    hex = ""
}

function slug(s) {
    gsub(/tls13 /, "", s)
    gsub(/[^a-zA-Z0-9]+/, "_", s)
    gsub(/^_|_$/, "", s)
    return tolower(s)
}

BEGIN {
    print "/* Generated by tools/vectors/extract.awk from RFC 8448 section 3."
    print " * Do not edit: regenerate instead, so the vectors stay traceable to the document. */"
    print "#ifndef LC_TEST_VECTORS_H"
    print "#define LC_TEST_VECTORS_H"
    print ""
    print "#include <stdint.h>"
    print ""
    in_section = 0
    block = ""
}

/^3\.  Simple 1-RTT Handshake/ { in_section = 1; next }
/^4\.  Resumed 0-RTT Handshake/ { in_section = 0 }
!in_section { next }

# A new operation starts a new block. "(same as ...)" repeats an earlier value and carries no data.
# The role is part of the name: both sides derive "write traffic keys for application data" with
# their own values, and folding them together would silently keep whichever came last.
/^   \{(server|client)\}  (extract|derive) / {
    flush_field()
    if ($0 ~ /same as/) { block = ""; next }
    role = ($0 ~ /^   \{server\}/) ? "srv" : "cli"
    line = $0
    sub(/^   \{(server|client)\}  /, "", line)
    sub(/:$/, "", line)
    sub(/^extract secret /, "extract_", line)
    sub(/^derive secret for handshake /, "derive_hs_", line)
    sub(/^derive secret for master /, "derive_master_", line)
    sub(/^derive secret /, "derive_", line)
    sub(/^derive write traffic keys for /, "wkeys_", line)
    sub(/^derive read traffic keys for /, "rkeys_", line)
    block = role "_" slug(line)
    next
}

# Finished is where a handshake first goes visibly wrong against a real server, and the trace gives
# every input: the traffic secret it derives from, the empty-context HkdfLabel, the finished key, and
# the verify_data itself. Both roles compute one, so the role prefix matters here too.
/^   \{(server|client)\}  calculate finished/ {
    flush_field()
    if ($0 ~ /same as/) { block = ""; next }
    role = ($0 ~ /^   \{server\}/) ? "srv" : "cli"
    block = role "_finished"
    next
}

# The ephemeral key pairs. Together with the shared secret that turns up as the IKM of the
# handshake extract, they make a complete test for the key exchange: private key in, peer public
# key in, a value the rest of the schedule already depends on out.
/^   \{(server|client)\}  create an ephemeral/ {
    flush_field()
    role = ($0 ~ /^   \{server\}/) ? "srv" : "cli"
    curve = $0
    sub(/^.*create an ephemeral /, "", curve)
    sub(/ key pair:$/, "", curve)
    block = role "_" slug(curve)
    next
}

# Sent records carry both halves of what the record layer has to get right: the plaintext the
# handshake produced, and the bytes that went on the wire. For protected records the second is the
# first sealed under the traffic keys, which makes them a complete AEAD vector.
# They are numbered per role in the order they appear, because that order is also the sequence
# number the nonce is built from.
/^   \{(server|client)\}  send .* record:/ {
    flush_field()
    role = ($0 ~ /^   \{server\}/) ? "srv" : "cli"
    block = role "_record_" (++record_no[role])
    next
}

# The handshake messages themselves, as constructed before any encryption. These are what makes a
# CertificateVerify testable at all: the trace carries the server's certificate, the signature over
# the transcript, and every message that transcript is made of, from a document nobody in this
# repository wrote. A signature check tested against a signature this client produced proves only
# that it agrees with itself — which is how a construction missing one byte passed its own tests.
#
# The field name is the message name, so the block is the same for all of them and each message
# lands as srv_msg_<name>.
/^   \{(server|client)\}  construct a[n]? .* handshake message:/ {
    flush_field()
    role = ($0 ~ /^   \{server\}/) ? "srv" : "cli"
    block = role "_msg"
    next
}

# Any other {tag} line ends the current block: what follows is a message, not a derivation.
/^   \{/ { flush_field(); block = ""; next }

block == "" { next }

# "      salt (32 octets):  6f 26 ..." starts a field; continuation lines are indented further.
/^      [A-Za-z][A-Za-z0-9 ]*\([0-9]+ octets\):/ {
    flush_field()
    name = $0
    sub(/^      /, "", name)
    sub(/ *\(.*$/, "", name)
    field = slug(name)
    rest = $0
    sub(/^.*octets\): */, "", rest)
    hex = rest
    next
}

/^         [0-9a-f][0-9a-f]( |$)/ {
    if (field != "") {
        rest = $0
        sub(/^ +/, "", rest)
        hex = hex " " rest
    }
    next
}

END {
    flush_field()
    print ""
    print "#endif"
}
